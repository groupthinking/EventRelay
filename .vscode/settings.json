{
    "files.autoSave": "afterDelay",
    "workbench.experimental.cloudChanges.autoStore": "onShutdown",
    "redhat.telemetry.enabled": true,
    "gitlens.ai.largePromptWarningThreshold": 200000,
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "gitlens.launchpad.indicator.useColors": true,
    "codeQL.createQuery.qlPackLocation": "/Users/garvey/Dev/projects/EventRelay",
    "github-actions.workflows.pinned.workflows": [
        ".github/workflows/coverage.yml"
    ],
    "git.autofetch": "all",
    "workbench.experimental.cloudChanges.partialMatches.enabled": true,
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "editor.formatOnPaste": true,
    "editor.allowVariableFontsInAccessibilityMode": true,
    "editor.autoIndentOnPaste": true,
    "editor.codeActions.triggerOnFocusChange": true,
    "editor.defaultFoldingRangeProvider": "google.antigravity",
    "editor.experimentalGpuAcceleration": "on",
    "editor.gotoLocation.alternativeImplementationCommand": "editor.action.goToImplementation",
    "editor.gotoLocation.alternativeReferenceCommand": "editor.action.goToReferences",
    "editor.inlineCompletionsAccessibilityVerbose": true,
    "editor.linkedEditing": true,
    "editor.renderWhitespace": "all",
    "editor.find.autoFindInSelection": "always",
    "diffEditor.codeLens": true,
    "diffEditor.experimental.showMoves": true,
    "diffEditor.experimental.useTrueInlineView": true,
    "editor.inlineSuggest.experimental.showOnSuggestConflict": "whenSuggestListIsIncomplete",
    "editor.suggest.preview": true,
    "editor.suggest.shareSuggestSelections": true,
    "files.autoGuessEncoding": true,
    "files.trimFinalNewlines": true,
    "files.simpleDialog.enable": true,
    "files.trimTrailingWhitespace": true,
    "workbench.auxiliaryActivityBar.location": "default",
    "workbench.commandPalette.experimental.askChatLocation": "quickChat",
    "workbench.experimental.share.enabled": true,
    "workbench.startupEditor": "terminal",
    "workbench.editor.autoLockGroups": {
        "vscode.videoPreview": true
    },
    "workbench.editor.enablePreviewFromQuickOpen": true,
    "testing.automaticallyOpenPeekView": "failureAnywhere",
    "testing.automaticallyOpenPeekViewDuringAutoRun": true,
    "editor.formatOnType": true,
    "editor.inlineSuggest.suppressSuggestions": true,
    "workbench.editor.closeOnFileDelete": true,
    "debug.console.closeOnEnd": true,
    "debug.openExplorerOnEnd": true,
    "extensions.closeExtensionDetailsOnViewChange": true,
    "geminicodeassist.agentYoloMode": true,
    "geminicodeassist.updateChannel": "Insiders",
    "git.closeDiffOnOperation": true,
    "git.replaceTagsWhenPull": true,
    "gitlens.launchpad.indicator.polling.interval": 10,
    "go.toolsManagement.autoUpdate": true,
    "cloudcode.updateChannel": "Insiders",
    "typescript.updateImportsOnFileMove.enabled": "always",
    "gitlens.ai.experimental.composer.enabled": true,
    "containers.contexts.showInStatusBar": true,
    "java.completion.chain.enabled": true,
    "java.implementationCodeLens": "all",
    "geminicodeassist.agentDebugMode": true,
    "githubPullRequests.codingAgent.uiIntegration": true,
    "gitlab.duoAgentPlatform.connectionType": "grpc",
    "geminicodeassist.rules": ""
}