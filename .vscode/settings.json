{
    "files.autoSave": "afterDelay",
    "workbench.experimental.cloudChanges.autoStore": "onShutdown",
    "redhat.telemetry.enabled": true,
    "gitlens.ai.largePromptWarningThreshold": 200000,
    "python.defaultInterpreterPath": ".venv/bin/python",
    "gitlens.launchpad.indicator.useColors": true,
    "codeQL.createQuery.qlPackLocation": "/Users/garvey/Dev/projects/EventRelay",
    "github-actions.workflows.pinned.workflows": [
        ".github/workflows/coverage.yml"
    ],
    "git.autofetch": "all",
    "workbench.experimental.cloudChanges.partialMatches.enabled": true,
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "editor.formatOnPaste": true,
    "editor.allowVariableFontsInAccessibilityMode": true,
    "editor.autoIndentOnPaste": true,
    "editor.codeActions.triggerOnFocusChange": true,
    "editor.defaultFoldingRangeProvider": "google.antigravity",
    "editor.experimentalGpuAcceleration": "on",
    "editor.gotoLocation.alternativeImplementationCommand": "editor.action.goToImplementation",
    "editor.gotoLocation.alternativeReferenceCommand": "editor.action.goToReferences",
    "editor.inlineCompletionsAccessibilityVerbose": true,
    "editor.linkedEditing": true,
    "editor.renderWhitespace": "all",
    "editor.find.autoFindInSelection": "always",
    "diffEditor.codeLens": true,
    "diffEditor.experimental.showMoves": true,
    "diffEditor.experimental.useTrueInlineView": true,
    "editor.inlineSuggest.experimental.showOnSuggestConflict": "whenSuggestListIsIncomplete",
    "editor.suggest.preview": true,
    "editor.suggest.shareSuggestSelections": true,
    "files.autoGuessEncoding": true,
    "files.trimFinalNewlines": true,
    "files.simpleDialog.enable": true,
    "files.trimTrailingWhitespace": true,
    "workbench.auxiliaryActivityBar.location": "default",
    "workbench.commandPalette.experimental.askChatLocation": "quickChat",
    "workbench.experimental.share.enabled": true,
    "workbench.startupEditor": "terminal",
    "workbench.editor.autoLockGroups": {
        "vscode.videoPreview": true,
        "antigravity.globalArtifactsEditorInput": true,
        "default": true,
        "antigravity.artifactsEditorInput": true
    },
    "workbench.editor.enablePreviewFromQuickOpen": true,
    "testing.automaticallyOpenPeekView": "failureAnywhere",
    "testing.automaticallyOpenPeekViewDuringAutoRun": true,
    "editor.formatOnType": true,
    "editor.inlineSuggest.suppressSuggestions": true,
    "workbench.editor.closeOnFileDelete": true,
    "debug.console.closeOnEnd": true,
    "debug.openExplorerOnEnd": true,
    "extensions.closeExtensionDetailsOnViewChange": true,
    "geminicodeassist.agentYoloMode": true,
    "geminicodeassist.updateChannel": "Insiders",
    "git.closeDiffOnOperation": true,
    "git.replaceTagsWhenPull": true,
    "gitlens.launchpad.indicator.polling.interval": 10,
    "go.toolsManagement.autoUpdate": true,
    "cloudcode.updateChannel": "Insiders",
    "typescript.updateImportsOnFileMove.enabled": "always",
    "gitlens.ai.experimental.composer.enabled": true,
    "containers.contexts.showInStatusBar": true,
    "java.completion.chain.enabled": true,
    "java.implementationCodeLens": "all",
    "geminicodeassist.agentDebugMode": true,
    "githubPullRequests.codingAgent.uiIntegration": true,
    "gitlab.duoAgentPlatform.connectionType": "grpc",
    "geminicodeassist.rules": "",
    "workbench.editor.enablePreviewFromCodeNavigation": true,
    "dart.previewFlutterUiGuides": true,
    "mediaPreview.video.autoPlay": true,
    "terminal.integrated.suggest.enabled": false,
    "terminal.integrated.sendKeybindingsToShell": true,
    "dart.enableCompletionCommitCharacters": true,
    "geminicodeassist.codeGenerationPaneViewEnabled": true,
    "geminicodeassist.inlineSuggestions.nextEditPredictions": true,
    "geminicodeassist.inlineSuggestions.suggestionSpeed": "Fast",
    "geminicodeassist.outlines.automaticOutlineGeneration": true,
    "dart.experimentalDtdHandlers": true,
    "dart.previewFlutterUiGuidesCustomTracking": true,
    "claudeCode.hideOnboarding": true,
    "colab.serverMounting": true,
    "colab.terminal": true,
    "task.verboseLogging": true,
    "problems.showCurrentInStatus": true,
    "interactiveWindow.executeWithShiftEnter": true,
    "interactiveWindow.promptToSaveOnClose": true,
    "notebook.consolidatedRunButton": true,
    "notebook.experimental.remoteSave": true,
    "notebook.formatOnSave.enabled": true,
    "notebook.multiCursor.enabled": true,
    "notebook.outline.showCodeCells": true,
    "notebook.variablesView": true,
    "firebase.dataConnect.alwaysAllowMutationsInProduction": true,
    "firefox.keepProfileChanges": false,
    "tfa.system.autoAccept": true,
    "workbench.editor.alwaysShowEditorActions": true,
    "workbench.editor.preferHistoryBasedLanguageDetection": true,
    "typescript.disableAutomaticTypeAcquisition": true,
    "accessibility.openChatEditedFiles": true,
    "vim.autoSwitchInputMethod.enable": true,
    "window.autoDetectColorScheme": true,
    "dart.flutterAdbConnectOnChromeOs": true,
    "maven.pomfile.autoUpdateEffectivePOM": true,
    "githubPullRequests.deleteBranchAfterMerge": true,
    "vscode-kubernetes.log-viewer.autorun": true,
    "mediaPreview.video.loop": true,
    "merge-conflict.autoNavigateNextConflict.enabled": true,
    "php.format.rules.addCommaAfterLastArrayElement": true,
    "php.format.rules.addCommaAfterLastCallParameter": true,
    "php.format.rules.addCommaAfterLastDeclParameter": true,
    "php.format.rules.alignConsecutiveAssignments": true,
    "php.format.rules.alignConstants": true,
    "php.format.rules.alignEnumCases": true,
    "php.format.rules.alignMatchArmBodies": true,
    "php.format.rules.alignProperties": true,
    "php.format.rules.arrayInitializersAlignKeyValuePairs": true,
    "python.analysis.completeFunctionParens": true,
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.revealIfOpen": true,
    "workbench.editor.showTabIndex": true
}