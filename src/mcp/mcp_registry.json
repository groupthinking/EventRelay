{
  "tools": [
    {
      "name": "youtube_uvai_processor",
      "transport": "stdio",
      "command": [
        "python3",
        "mcp-servers/python-suite/youtube_uvai_mcp.py"
      ],
      "env": {
        "YOUTUBE_API_KEY": "${YOUTUBE_API_KEY}"
      },
      "health": {
        "method": "tools/list",
        "params": {}
      }
    },
    {
      "name": "video_agent",
      "transport": "stdio",
      "command": [
        "python3",
        "mcp-servers/python-suite/video_agent_server.py"
      ],
      "health": {
        "method": "tools/list",
        "params": {}
      }
    },
    {
      "name": "code_analysis",
      "transport": "stdio",
      "command": [
        "python3",
        "mcp-servers/python-suite/code_analysis_server.py"
      ],
      "health": {
        "method": "tools/list",
        "params": {}
      }
    },
    {
      "name": "vercel",
      "transport": "sse",
      "url": "https://mcp.vercel.com/sse",
      "env": {
        "VERCEL_TOKEN": "${VERCEL_TOKEN}",
        "VERCEL_TEAM_ID": "${VERCEL_TEAM_ID}"
      },
      "description": "Vercel MCP server — list deployments, fetch logs, inspect env vars, manage projects",
      "health": {
        "method": "tools/list",
        "params": {}
      }
    }
  ]
}