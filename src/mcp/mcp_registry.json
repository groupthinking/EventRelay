{
  "canonical_orchestrator": "mcpc",
  "tools": [
    {
      "name": "mcpc",
      "description": "MCPC — Canonical MCP orchestrator. Consolidates round-table, tool management, and shared state from 8 previously scattered repos.",
      "transport": "stdio",
      "command": [
        "node",
        "mcp-servers/mcpc/dist/index.js"
      ],
      "health": {
        "method": "tools/list",
        "params": {}
      }
    },
    {
      "name": "youtube_uvai_processor",
      "transport": "stdio",
      "command": [
        "python3",
        "mcp-servers/python-suite/youtube_uvai_mcp.py"
      ],
      "env": {
        "YOUTUBE_API_KEY": "${YOUTUBE_API_KEY}"
      },
      "health": {
        "method": "tools/list",
        "params": {}
      }
    },
    {
      "name": "video_agent",
      "transport": "stdio",
      "command": [
        "python3",
        "mcp-servers/python-suite/video_agent_server.py"
      ],
      "health": {
        "method": "tools/list",
        "params": {}
      }
    },
    {
      "name": "code_analysis",
      "transport": "stdio",
      "command": [
        "python3",
        "mcp-servers/python-suite/code_analysis_server.py"
      ],
      "health": {
        "method": "tools/list",
        "params": {}
      }
    }
  ]
}