# .dockerignore — Exclude unnecessary files from Docker build context

# Version Control
.git/
.gitignore

# Node dependencies (rebuilt in container)
node_modules/
apps/web/node_modules/
apps/web/.next/

# Python artifacts
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# IDE & System
.idea/
.vscode/
.DS_Store
*.swp

# Logs & Data
*.log
logs/
*.db
*.sqlite3

# Config & Secrets
.env*
!.env.example
*.pem
*.key
*.cert
*secret*.json
gha-creds-*.json

# Chrome / NotebookLM browser profiles
notebooklm_chrome_profile/
src/utils/notebooklm_profile/
src/utils/notebooklm_profile_v2/

# Research & Archives
research/
docs/
_archive/
.gemini/
ai-edge-torch/
external/
google-cloud-sdk/
chrome_build/
safari_build/
generated_projects/
youtube_processed_videos/
terraform_export/
video_representations_extractor-*/
build_extensions/

# Test & Coverage
tests/
coverage/
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Infrastructure (not needed in app image)
infrastructure/
supabase/
mcp-servers/

# CI/CD
.github/
