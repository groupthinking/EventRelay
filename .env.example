#   python -c "import secrets; print(secrets.token_urlsafe(32))"
EVENTRELAY_API_KEY=
# Local-dev ONLY escape hatch. If EVENTRELAY_API_KEY is unset, the API fails
# closed (HTTP 503) on protected routes UNLESS this is set to 1. Never set in prod.
ALLOW_UNAUTHENTICATED=

# --- Frontend (Next.js) login gating & abuse controls ---
# Set ALL four to enable NextAuth login-gating of /dashboard and /api/* (Google
# OAuth by default). Until NEXTAUTH_SECRET is set, the frontend is NOT gated.
#   Generate a secret:  openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Legacy fallback variables are also supported:
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: restrict sign-in to a single email domain (e.g. uvai.io)
AUTH_ALLOWED_EMAIL_DOMAIN=
# Frontend per-IP API rate limit (requests/min; <=0 disables)
API_RATE_LIMIT_PER_MIN=60
# Shared token letting server-to-server loopback calls bypass the limiter/auth
INTERNAL_REQUEST_TOKEN=

# ============================================================================
# YOUTUBE INTEGRATION
# ============================================================================
# YouTube Data API v3 Key - Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Webshare residential rotating proxy for yt-dlp / youtube-transcript-api
# (avoids YouTube blocking cloud IP ranges). Leave empty for direct connection.
# Format: http://user:pass@p.webshare.io:80
WEBSHARE_PROXY_URL=

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Development (SQLite)
DATABASE_URL=sqlite:///./.runtime/app.db
