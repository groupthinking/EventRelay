{
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "type": "http",
      "headers": {
        "Authorization": "Bearer $GITHUB_TOKEN"
      },
      "trust": false
    },
    "git-workflow": {
      "command": "node",
      "args": [
        "tools/mcp/git_workflow_server.mjs"
      ],
      "env": {
        "GIT_WORKSPACE_ROOT": ".",
        "GIT_DEFAULT_REMOTE": "origin"
      },
      "trust": true
    },
    "stitch": {
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "Authorization": "Bearer $STITCH_ACCESS_TOKEN",
        "X-Goog-User-Project": "$STITCH_USER_PROJECT"
      },
      "trust": false
    }
  }
}
