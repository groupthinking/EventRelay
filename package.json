{
  "name": "eventrelay",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build:web": "cd apps/web && npm run build",
