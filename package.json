    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "brace-expansion": "^1.1.12",
    "turbo": "^2.9.18",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "next": ">=16.2.6",
    "nth-check": "^2.0.1",
    "postcss": "^8.5.15",
    "undici": "^6.22.0",
    "esbuild": "^0.27.2",
    "uuid": "11.1.1",
    "@temporalio/client": {
      "uuid": "11.1.1"
    },
    "vite": "^6.4.3",
    "picomatch": ">=2.3.2",
    "protobufjs": "^7.6.2",
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.12"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "^2.0.3"
    }
  },
  "dependencies": {
