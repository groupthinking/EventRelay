{
  "name": "eventrelay",
  "version": "2.0.0",
  "private": true,
  "packageManager": "npm@10.8.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build:web": "cd apps/web && npm run build",
    "dev:web": "cd apps/web && npm run dev",
    "install:all": "npm install"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "mcp-servers/*"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "turbo": "^2.0.0"
  },
  "overrides": {
    "nth-check": "^2.0.1",
    "postcss": "^8.4.31",
    "undici": "^6.22.0",
    "esbuild": "^0.27.2"
  },
  "dependencies": {
    "@langchain/core": "^1.1.19",
    "@langchain/langgraph": "^0.4.9",
    "@langchain/openai": "^1.2.5",
    "chrome-devtools-mcp": "^0.10.2"
  }
}