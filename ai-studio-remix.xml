    );

    const variants = {
      primary: clsx(
        'bg-gradient-to-r from-primary-500 to-primary-600',
        'text-white shadow-lg shadow-primary-500/25',
        'hover:shadow-xl hover:shadow-primary-500/30 hover:-translate-y-0.5',
