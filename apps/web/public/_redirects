# Cloudflare Pages Redirects
# This file handles redirects for uvai-io.pages.dev → uvai.io
# See: https://developers.cloudflare.com/pages/configuration/redirects/

# Redirect Cloudflare Pages domain to canonical domain
https://uvai-io.pages.dev/* https://uvai.io/:splat 301!

# Redirect www to non-www
https://www.uvai.io/* https://uvai.io/:splat 301!

# Legacy Vercel domains
https://event-relay-web.vercel.app/* https://uvai.io/:splat 301!
https://v0-uvai.vercel.app/* https://uvai.io/:splat 301!
https://youtube-extension.vercel.app/* https://uvai.io/:splat 301!
