# EventRelay API configuration. All vars use the EVENTRELAY_ prefix.
# Copy to .env for local use (.env is gitignored). Unset values fall back to
# safe local defaults (in-memory store, no live model calls).

# ── App ──
EVENTRELAY_APP_NAME=EventRelay API
EVENTRELAY_APP_VERSION=0.1.0
EVENTRELAY_ENVIRONMENT=development

# ── SC6 persistence ──
# Unset → in-memory store (tests/local). Production = Postgres async DSN:
# EVENTRELAY_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/eventrelay

# Part of the idempotency key (video_id:pipeline_version). Bump when the
# pipeline's output for a given URL would legitimately change.
EVENTRELAY_PIPELINE_VERSION=1

# ── SC3/SC4 model seam ──
# EVENTRELAY_GEMINI_API_KEY=your-key-here
EVENTRELAY_LLM_MODEL=gemini-2.5-flash
