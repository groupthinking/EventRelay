<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: linear-gradient(135deg, #0F0F23 0%, #1A1A3A 100%);
            color: #FFFFFF;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .hero-section {
            background: linear-gradient(135deg, #2D3436 0%, #0984E3 100%);
            padding: 60px 40px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .hero-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M 10 0 L 0 0 0 10" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="0.5"/></pattern></defs><rect width="100" height="100" fill="url(%23grid)"/></svg>');
            opacity: 0.3;
        }

        .hero-content {
            position: relative;
            z-index: 1;
        }

        .hero-title {
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 20px;
            background: linear-gradient(135deg, #FFFFFF 0%, #00B894 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-subtitle {
            font-size: 1.4rem;
            font-weight: 300;
            margin-bottom: 30px;
            opacity: 0.9;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin: 40px;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 16px;
            padding: 30px;
            text-align: center;
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            background: rgba(255, 255, 255, 0.15);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        }

        .stat-number {
            font-size: 3rem;
            font-weight: 800;
            color: #00B894;
            margin-bottom: 10px;
        }

        .stat-label {
            font-size: 1rem;
            opacity: 0.8;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .main-content {
            padding: 60px 40px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .section {
            margin-bottom: 60px;
        }

        .section-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 30px;
            background: linear-gradient(135deg, #FFFFFF 0%, #0984E3 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .search-container {
            margin-bottom: 40px;
        }

        .search-box {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
        }

        .search-input {
            flex: 1;
            padding: 15px 20px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            color: #FFFFFF;
            font-size: 1rem;
            backdrop-filter: blur(10px);
        }

        .search-input::placeholder {
            color: rgba(255, 255, 255, 0.6);
        }

        .search-btn {
            padding: 15px 30px;
            background: linear-gradient(135deg, #0984E3 0%, #00B894 100%);
            border: none;
            border-radius: 12px;
            color: white;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .search-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(9, 132, 227, 0.3);
        }

        .insights-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 30px;
        }

        .insight-panel {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 30px;
            backdrop-filter: blur(10px);
        }

        .insight-title {
            font-size: 1.4rem;
            font-weight: 600;
            margin-bottom: 20px;
            color: #00B894;
        }

        .item-list {
            list-style: none;
        }

        .item {
            padding: 12px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .item:last-child {
            border-bottom: none;
        }

        .item-title {
            font-weight: 500;
            color: #FFFFFF;
        }

        .item-meta {
            font-size: 0.85rem;
            opacity: 0.6;
        }

        .tag {
            display: inline-block;
            background: rgba(9, 132, 227, 0.2);
            color: #0984E3;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            margin: 2px;
            border: 1px solid rgba(9, 132, 227, 0.3);
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 40px;
        }

        .action-btn {
            padding: 15px 30px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            color: white;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .action-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }

        .action-btn.primary {
            background: linear-gradient(135deg, #0984E3 0%, #00B894 100%);
            border: none;
        }

        .footer {
            text-align: center;
            padding: 40px;
            opacity: 0.6;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            margin-top: 60px;
        }

        .pulse {
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.5; }
            100% { opacity: 1; }
        }

        @media (max-width: 768px) {
            .hero-title {
                font-size: 2.5rem;
            }
            
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
                margin: 20px;
            }
            
            .main-content {
                padding: 40px 20px;
            }
            
            .insights-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="hero-section">
        <div class="hero-content">
            <h1 class="hero-title">HAYDEN GARVEY</h1>
            <p class="hero-subtitle">AI-Driven Intelligence Hub & Command Center</p>
            <p class="hero-subtitle">Model Context Protocol • Quantum Business Automation • Multi-Agent Systems</p>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-number"><%= stats.conversations %></div>
            <div class="stat-label">Conversations</div>
        </div>
        <div class="stat-card">
            <div class="stat-number"><%= stats.prompts %></div>
            <div class="stat-label">AI Prompts</div>
        </div>
        <div class="stat-card">
            <div class="stat-number"><%= stats.mcpContexts %></div>
            <div class="stat-label">MCP Contexts</div>
        </div>
        <div class="stat-card">
            <div class="stat-number"><%= stats.projects %></div>
            <div class="stat-label">Active Projects</div>
        </div>
    </div>

    <div class="main-content">
        <div class="section">
            <h2 class="section-title">Universal Search</h2>
            <div class="search-container">
                <div class="search-box">
                    <input type="text" class="search-input" id="searchInput" placeholder="Search conversations, prompts, projects, MCP contexts...">
                    <button class="search-btn" onclick="performSearch()">Search</button>
                </div>
                <div id="searchResults"></div>
            </div>
        </div>

        <div class="section">
            <h2 class="section-title">Intelligence Overview</h2>
            <div class="insights-grid">
                <div class="insight-panel">
                    <h3 class="insight-title">🔥 Top Prompts (by Score)</h3>
                    <ul class="item-list">
                        <% insights.topPrompts.slice(0, 5).forEach(prompt => { %>
                        <li class="item">
                            <div>
                                <div class="item-title">Idea #<%= prompt.id %></div>
                                <div class="item-meta">Score: <%= prompt.score %> | Tags: 
                                    <% prompt.tags.forEach(tag => { %>
                                        <span class="tag"><%= tag %></span>
                                    <% }); %>
                                </div>
                            </div>
                        </li>
                        <% }); %>
                    </ul>
                </div>

                <div class="insight-panel">
                    <h3 class="insight-title">💬 Recent Conversations</h3>
                    <ul class="item-list">
                        <% insights.recentConversations.forEach(conv => { %>
                        <li class="item">
                            <div>
                                <div class="item-title"><%= conv.title %></div>
                                <div class="item-meta"><%= conv.messageCount %> messages | Topics: 
                                    <% conv.topics.slice(0, 3).forEach(topic => { %>
                                        <span class="tag"><%= topic %></span>
                                    <% }); %>
                                </div>
                            </div>
                        </li>
                        <% }); %>
                    </ul>
                </div>

                <div class="insight-panel">
                    <h3 class="insight-title">📊 Top Research Areas</h3>
                    <ul class="item-list">
                        <% insights.topTags.slice(0, 8).forEach(item => { %>
                        <li class="item">
                            <span class="item-title"><%= item.tag.toUpperCase() %></span>
                            <span class="item-meta"><%= item.count %> instances</span>
                        </li>
                        <% }); %>
                    </ul>
                </div>
            </div>
        </div>

        <div class="section">
            <h2 class="section-title">Command Center</h2>
            <div class="action-buttons">
                <button class="action-btn primary" onclick="discoverData()">🔍 Discover New Data</button>
                <a href="/api/analytics" class="action-btn">📈 View Analytics</a>
                <a href="/api/status" class="action-btn">⚙️ System Status</a>
                <button class="action-btn" onclick="generateVisualization()">🎨 Generate Visualization</button>
            </div>
        </div>
    </div>

    <div class="footer">
        <p>Last Updated: <%= new Date(timestamp).toLocaleString() %></p>
        <p>Powered by MCP Framework • Desktop Hub Intelligence</p>
    </div>

    <script>
        async function performSearch() {
            const query = document.getElementById('searchInput').value;
            if (!query.trim()) return;

            const resultsDiv = document.getElementById('searchResults');
            resultsDiv.innerHTML = '<div class="pulse">Searching...</div>';

            try {
                const response = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
                const results = await response.json();

                let html = '<div class="insight-panel" style="margin-top: 20px;"><h3 class="insight-title">Search Results</h3>';
                
                if (results.conversations.length > 0) {
                    html += '<h4 style="color: #00B894; margin: 15px 0 10px 0;">Conversations</h4>';
                    results.conversations.slice(0, 3).forEach(conv => {
                        html += `<div class="item">
                            <div class="item-title">${conv.title}</div>
                            <div class="item-meta">${conv.topics.map(t => `<span class="tag">${t}</span>`).join('')}</div>
                        </div>`;
                    });
                }

                if (results.prompts.length > 0) {
                    html += '<h4 style="color: #00B894; margin: 15px 0 10px 0;">AI Prompts</h4>';
                    results.prompts.slice(0, 3).forEach(prompt => {
                        html += `<div class="item">
                            <div class="item-title">Idea #${prompt.id} (Score: ${prompt.score})</div>
                            <div class="item-meta">${prompt.tags.map(t => `<span class="tag">${t}</span>`).join('')}</div>
                        </div>`;
                    });
                }

                html += '</div>';
                resultsDiv.innerHTML = html;
            } catch (error) {
                resultsDiv.innerHTML = `<div style="color: #e74c3c;">Error: ${error.message}</div>`;
            }
        }

        async function discoverData() {
            const btn = event.target;
            btn.textContent = '🔄 Discovering...';
            btn.disabled = true;

            try {
                const response = await fetch('/api/discover', { method: 'POST' });
                const result = await response.json();
                
                if (result.success) {
                    alert('Data discovery completed! Page will refresh to show new data.');
                    location.reload();
                } else {
                    alert('Discovery failed: ' + result.error);
                }
            } catch (error) {
                alert('Discovery error: ' + error.message);
            }

            btn.textContent = '🔍 Discover New Data';
            btn.disabled = false;
        }

        async function generateVisualization() {
            const btn = event.target;
            btn.textContent = '🎨 Generating...';
            btn.disabled = true;

            try {
                const response = await fetch('/api/mcp/extract', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        source: 'visualization',
                        parameters: { type: 'dashboard-summary' }
                    })
                });
                
                const result = await response.json();
                alert('Visualization generated! Check the project directory for output files.');
            } catch (error) {
                alert('Visualization error: ' + error.message);
            }

            btn.textContent = '🎨 Generate Visualization';
            btn.disabled = false;
        }

        // Auto-search on Enter key
        document.getElementById('searchInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                performSearch();
            }
        });
    </script>
</body>
</html>