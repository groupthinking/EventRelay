{
  "version": 1,
  "hooks": {
    "afterMCPExecution": [
      {
        "command": ".cursor/scripts/ace_track_mcp.sh"
      }
    ],
    "afterShellExecution": [
      {
        "command": ".cursor/scripts/ace_track_shell.sh"
      }
    ],
    "afterAgentResponse": [
      {
        "command": ".cursor/scripts/ace_track_response.sh"
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/scripts/ace_track_edit.sh"
      }
    ],
    "stop": [
      {
        "command": ".cursor/scripts/ace_stop_hook.sh"
      }
    ]
  }
}