{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npm ci --legacy-peer-deps",
      "buildCommand": "npm run build",
      "outputDirectory": ".next",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    },
    "backend": {
      "root": "apps/backend",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "event-relay-web.vercel.app" }
      ],
      "destination": "https://uvai.io/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "v0-uvai.vercel.app" }
      ],
      "destination": "https://uvai.io/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
